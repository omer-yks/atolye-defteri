{
  "name": "atolye-defteri",
  "productName": "Atolye Defteri",
  "version": "1.0.1",
  "description": "Atölye Defteri masaüstü uygulaması",
  "author": "for3D design",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.for3d.atolyedefteri",
    "productName": "Atolye Defteri",
    "copyright": "for3D design",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sesle yazmak için mikrofon kullanılır.",
        "NSCameraUsageDescription": "Kamera kullanılmaz.",
        "CFBundleDisplayName": "Atölye Defteri"
      }
    }
  }
}